# Generated by the cppcheck-wrapper command. The build dir holds its incremental
# cache and the raw XML.
cppcheck/build/
cppcheck/cppcheck-wrapper.xml
cppcheck/html-report/
cppcheck/misra-deviations.json
cppcheck/__pycache__/
# Derived from the build's own database by augment-compile-db.py.
cppcheck/compile_commands_with_includes.json
# The virtual environment holding the cppcheck-wrapper package, and ad-hoc build
# dirs used while iterating.
cppcheck/.venv/
cppcheck/.cc-*/
cppcheck/build-*/
vee/build*
vee/inc
vee/lib
vee/scripts/set_local_env.bat
vee/scripts/set_local_env.sh

